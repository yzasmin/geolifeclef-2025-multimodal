# Copier ce fichier en .env et remplir les valeurs. Le fichier .env n'est jamais commité.

# Chemins des données GeoLifeCLEF 2025 (voir README, section Reproduire)
GLC_DATA_DIR=./data
GLC_OUTPUT_DIR=./artifacts
GLC_CACHE_DIR=./.cache
CHECKPOINTS_DIR=./artifacts/checkpoints

# Serveur MCP (MCP_server/)
DATA_DIR=./data
DATA_CSV_PATH=./data/GLC25_PA_metadata_train.csv
TIFF_ROOT=./data/SatelitePatches/PA-train
EXPLAIN_DEVICE=cpu

# LLM : choisir un fournisseur (ollama par défaut, openrouter ou github_models)
AGENT_LLM_PROVIDER=ollama
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# OpenRouter (optionnel)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# GitHub Models (optionnel, jeton fine-grained avec la permission Models: Read)
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4.1
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference/chat/completions
